{
  "expo": {
    "name": "AutoTracker",
    "slug": "autotracker",
    "scheme": "com.googleusercontent.apps.867501694584-oe8lrngvfils3a2mbsi130btl1u0qkt9",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#059669"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mabdelhay.autotracker"
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#059669"
      },
      "package": "com.mabdelhay.autotracker",
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you attach maintenance receipts."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a3a76090-2a85-4c8f-8ae4-93176ef160c4"
      }
    }
  }
}
